# Tuxedo OS 24.04 repositories, copied from a Tuxedo OS 24.04.4 host's
# /etc/apt/sources.list.d/tuxedo-*.sources. The Ubuntu archive comes through
# Tuxedo's mirror, as on the target. The vendor Qt/KDE stack is ubuntu-plasma.
Types: deb
URIs: https://mirrors.tuxedocomputers.com/ubuntu/mirror/archive.ubuntu.com/ubuntu
Suites: noble noble-updates
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: https://mirrors.tuxedocomputers.com/ubuntu/mirror/security.ubuntu.com/ubuntu
Suites: noble-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: https://txos.tuxedocomputers.com/ubuntu
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/tuxedo-archive-keyring.asc

Types: deb
URIs: https://txos-extra.tuxedocomputers.com/ubuntu
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/tuxedo-archive-keyring.asc

Types: deb
URIs: https://txos.tuxedocomputers.com/ubuntu-plasma
Suites: noble noble-updates
Components: main
Signed-By: /etc/apt/keyrings/tuxedo-archive-keyring.asc

Types: deb
URIs: https://deb.tuxedocomputers.com/ubuntu
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/tuxedo-archive-keyring.asc
