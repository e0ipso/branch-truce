Source: branch-truce
Section: kde
Priority: optional
Maintainer: Branch Truce contributors <contributors@example.invalid>
# The CMake, ECM, Qt, Kirigami and SyntaxHighlighting floors are the CMake
# API floors in CMakeLists.txt. Each OS base resolves them to its own
# packages; docs/target-platforms.md records the versions. Stock noble has no
# libkf6syntaxhighlighting-dev, so Tuxedo OS takes it from the vendor
# ubuntu-plasma repository.
Build-Depends: debhelper-compat (= 13),
               cmake (>= 3.28),
               extra-cmake-modules (>= 6.0~),
               git (>= 1:2.43~),
               libkf6syntaxhighlighting-dev (>= 6.0~),
               libkirigami-dev (>= 6.0~),
               qt6-base-dev (>= 6.6~),
               qt6-declarative-dev (>= 6.6~)
Standards-Version: 4.6.2
Rules-Requires-Root: no

Package: branch-truce
Architecture: amd64
# QML imports, desktop styling, the SVG icon engine and the Wayland shell
# integrations are loaded at run time, so dpkg-shlibdeps cannot see them.
# The binary links libKF6SyntaxHighlighting, so ${shlibs:Depends} adds
# libkf6syntaxhighlighting6, which pulls in its definitions package. The
# panes use the C++ API only, so there is no QML syntax-highlighting module.
# src/app/main.cpp selects the org.kde.desktop Qt Quick Controls style, so
# Kirigami loads its org.kde.desktop platform plugin. That plugin and the
# style ship in qml6-module-org-kde-desktop; qml6-module-org-kde-breeze
# holds the org.kde.breeze ones, which the app never selects.
# kde-style-breeze stays: org.kde.desktop paints its controls with the
# application's Qt widget style, and Breeze is that style on Plasma.
# plasma-integration is a Recommends. The installed package started on
# Wayland without it (docs/platform-validation.md), and Plasma desktops
# already have it through plasma-workspace.
Depends: git (>= 1:2.43~),
         hicolor-icon-theme,
         kde-style-breeze,
         kf6-breeze-icon-theme,
         qml6-module-org-kde-desktop,
         qml6-module-org-kde-kirigami (>= 6.0~),
         qml6-module-qtqml-models (>= 6.6~),
         qml6-module-qtqml-workerscript (>= 6.6~),
         qml6-module-qtquick (>= 6.6~),
         qml6-module-qtquick-controls (>= 6.6~),
         qml6-module-qtquick-layouts (>= 6.6~),
         qml6-module-qtquick-shapes (>= 6.6~),
         qml6-module-qtquick-templates (>= 6.6~),
         qml6-module-qtquick-window (>= 6.6~),
         qt6-svg-plugins (>= 6.6~),
         qt6-wayland (>= 6.6~),
         ${misc:Depends},
         ${shlibs:Depends}
Recommends: plasma-integration
Description: Standalone offline Git merge and rebase text conflict resolver for KDE
 Branch Truce opens every conflicted file of the current Git merge or rebase in
 one session. It shows both contributions around an editable result, keeps
 drafts inside the app until you mark a file resolved, and leaves unsupported
 files visible with the reason.
 .
 Separate amd64 builds target Kubuntu 26.04 and Tuxedo OS 24.04 with their
 distribution's Qt 6 and KDE Frameworks 6 libraries.
