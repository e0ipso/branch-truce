{
  "name": "branch-truce",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone offline Linux/KDE desktop application for resolving Git merge and rebase text conflicts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p scripts/tsconfig.json",
    "test": "node --test --test-reporter=spec 'scripts/**/*.test.ts'",
    "check:tracker-refs": "node scripts/check-tracker-refs.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/is-ignored": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
