# The merge engine includes only its own headers and the C++ standard library,
# so it builds and runs without Qt or any other part of the application.
if(NOT CORE_DIR)
    message(FATAL_ERROR "CORE_DIR must name src/core")
endif()
file(REAL_PATH "${CORE_DIR}" core_root)
file(GLOB_RECURSE sources "${core_root}/*.h" "${core_root}/*.cpp")
if(NOT sources)
    message(FATAL_ERROR "No engine sources found in ${CORE_DIR}")
endif()
set(violations "")
foreach(source IN LISTS sources)
    get_filename_component(source_directory "${source}" DIRECTORY)
    file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include")
    foreach(line IN LISTS includes)
        if(line MATCHES "#[ \t]*include[ \t]*\"([^\"]+)\"")
            set(header "${CMAKE_MATCH_1}")
            file(REAL_PATH "${source_directory}/${header}" resolved_header)
            string(FIND "${resolved_header}" "${core_root}/" inside_core)
            if(NOT inside_core EQUAL 0 OR NOT EXISTS "${resolved_header}")
                list(APPEND violations "${source}: ${line}")
            endif()
        elseif(line MATCHES "#[ \t]*include[ \t]*<([^>]+)>")
            # Standard headers have no extension and no directory; C headers
            # with .h, Qt headers and other libraries are outside the engine.
            if(CMAKE_MATCH_1 MATCHES "[./]" OR CMAKE_MATCH_1 MATCHES "^Q")
                list(APPEND violations "${source}: ${line}")
            endif()
        else()
            list(APPEND violations "${source}: ${line}")
        endif()
    endforeach()
endforeach()
if(violations)
    list(JOIN violations "\n" report)
    message(FATAL_ERROR "Engine sources include headers outside src/core and the standard library:\n${report}")
endif()
list(LENGTH sources count)
message(STATUS "${count} engine sources include only engine and standard headers")
