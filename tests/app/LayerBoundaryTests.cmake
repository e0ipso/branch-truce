# Each source directory includes only its own headers and those of the layers
# below it, so app and ui depend on the session layers and never the reverse.
# The layers under app also stay free of QML and Qt Quick, so they build and
# run without a display.
#
#   cmake -DSOURCE_DIR=<repository>/src -P LayerBoundaryTests.cmake
if(NOT SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR must name src")
endif()
set(allowed_problems problems)
set(allowed_storage core problems storage)
set(allowed_git core git problems storage)
set(allowed_recovery core git problems recovery storage)
set(allowed_session core git problems recovery session storage)
set(allowed_publication core git problems publication recovery session storage)
set(allowed_mergetool core git mergetool problems publication recovery session storage)
set(allowed_highlighting highlighting)
set(allowed_app app core git highlighting mergetool problems publication recovery session storage)
set(allowed_ui app highlighting ui)
set(headless problems storage git recovery session publication mergetool)
set(violations "")
set(count 0)
foreach(layer problems storage git recovery session publication mergetool highlighting app ui)
    file(GLOB sources "${SOURCE_DIR}/${layer}/*.h" "${SOURCE_DIR}/${layer}/*.cpp")
    foreach(source IN LISTS sources)
        math(EXPR count "${count} + 1")
        file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include")
        foreach(line IN LISTS includes)
            if(line MATCHES "#[ \t]*include[ \t]*\"([a-z]+)/")
                list(FIND allowed_${layer} "${CMAKE_MATCH_1}" found)
                if(found LESS 0)
                    list(APPEND violations "${source}: ${line}")
                endif()
            elseif(line MATCHES "#[ \t]*include[ \t]*<(QtQml|QtQuick|QQml|QQuick|QJSValue|QJSEngine)")
                list(FIND headless "${layer}" found)
                if(found GREATER_EQUAL 0)
                    list(APPEND violations "${source}: ${line}")
                endif()
            endif()
        endforeach()
    endforeach()
endforeach()
if(violations)
    list(JOIN violations "\n" report)
    message(FATAL_ERROR "Sources include a higher layer or QML below the app layer:\n${report}")
endif()
message(STATUS "${count} sources include only their own and lower layers")
