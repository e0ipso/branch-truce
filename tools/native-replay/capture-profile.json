{
  "version": 1,
  "environment": {
    "compositor": "private headless sway",
    "renderer": "pixman",
    "quick_backend": "software",
    "platform": "wayland",
    "physical_desktop": false,
    "colour_schemes": [
      "BreezeLight",
      "BreezeDark"
    ],
    "logical_sizes": [
      [
        1280,
        720
      ],
      [
        1280,
        800
      ]
    ],
    "scale": 1
  },
  "requested_fonts": {
    "normal": "Noto Sans 10pt",
    "fixed": "Hack 9pt",
    "small": "Observe Kirigami.Theme.smallFont; do not override"
  },
  "observations": "Each state.json contains actual resolved fonts, style, roles, units, DPI and DPR. capture_environment includes actual sway output and OS. build-provenance.json separates exact executable hash from observed source/build checkout identities.",
  "build_identity": "Executable SHA is authoritative; source HEAD is an observation, not proof of compiled identity",
  "reference_contract": "reference-contract.json",
  "pinned_observations": {
    "platform": "wayland",
    "quickControlsStyle": "org.kde.desktop",
    "iconTheme": "breeze",
    "fallbackIconTheme": "breeze",
    "devicePixelRatio": 1,
    "logicalDpi": 96,
    "physicalDesktop": false
  },
  "pinned_fonts": {
    "normal": {
      "resolvedFamily": "Noto Sans",
      "pointSize": 10
    },
    "small": {
      "resolvedFamily": "Noto Sans",
      "pointSize": 8
    },
    "fixed": {
      "resolvedFamily": "Hack",
      "pointSize": 9
    }
  }
}
